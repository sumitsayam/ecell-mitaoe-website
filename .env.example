# E-Cell MITAOE — Environment Configuration

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Database & Authentication (Supabase Integration Layer)
# Configure these when transitioning from Demo Mode to production PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Email Notifications (Resend or SendGrid)
# Optional: Used for automated registration confirmations and recruitment status updates
EMAIL_SERVER_API_KEY=your-email-api-key
EMAIL_FROM_ADDRESS=ecell@mitaoe.ac.in
